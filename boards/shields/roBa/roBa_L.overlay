#include "roBa.dtsi"

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH> 
        , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
        , <&xiao_d 7 GPIO_ACTIVE_HIGH> 
        , <&gpio0 10 GPIO_ACTIVE_HIGH> // NFC2
        ;
};

// トラックボールの物理ピン定義 (SCLK=D5, SDIO=D4, CS=NFC1, MOTION=D0)
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,  // D5 (P0.05)
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>, // D4 (P0.04)
                    <NRF_PSEL(SPIM_MISO, 0, 4)>; // SDIOなのでMOSIと同じ
        };
    };
};

&spi0 {
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-names = "default";

    trackball: trackball@0 {
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; // MOTION=D0
        cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>; // CS=NFC1 (P0.09)
    };
};

&trackball_listener {
    status = "okay";
    device = <&trackball>;
};
